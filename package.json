{
  "name": "mclone",
  "version": "0.0.0",
  "private": true,
  "description": "Native-first Minecraft-inspired voxel sandbox (private, personal use).",
  "type": "module",
  "scripts": {
    "test": "cargo test --manifest-path native/Cargo.toml",
    "host:check": "node ./scripts/check-host-capabilities.mjs",
    "native:scheduler:smoke": "cargo run --manifest-path native/Cargo.toml -p mclone-server --bin scheduler_movement_smoke --",
    "native:scheduler:perf": "cargo run --release --manifest-path native/Cargo.toml -p mclone-server --bin scheduler_movement_smoke --",
    "native:dedicated:smoke": "cargo run --manifest-path native/Cargo.toml -p mclone-dedicated-server -- --multi-client-smoke",
    "native:worldgen:smoke": "cargo run --manifest-path native/Cargo.toml -p mclone-worldgen --bin worldgen_perf --",
    "native:worldgen:perf": "cargo run --release --manifest-path native/Cargo.toml -p mclone-worldgen --bin worldgen_perf --",
    "native:worldgen:find-biome-seed": "cargo run --manifest-path native/Cargo.toml -p mclone-worldgen --bin find_biome_seed --",
    "native:runtime:smoke": "pnpm native:scheduler:smoke",
    "native:runtime:perf": "pnpm native:scheduler:perf",
    "native:movement:smoke": "cargo run --manifest-path native/Cargo.toml -p mclone-native-client -- --movement-perf",
    "native:movement:perf": "cargo run --release --manifest-path native/Cargo.toml -p mclone-native-client -- --movement-perf",
    "native:remote:smoke": "node ./scripts/native-remote-client-smoke.mjs",
    "native:desktop-offscreen:smoke": "cargo run --manifest-path native/Cargo.toml -p mclone-native-client -- --screenshot /tmp/mclone-desktop-offscreen.png --width 2560 --height 1600 --seed 12345 --chunk-x 0 --chunk-z 0 --render-distance 2 --day-time 6000 --freeze-time",
    "native:timedemo:smoke": "cargo run --manifest-path native/Cargo.toml -p mclone-native-client -- --timedemo --timedemo-frames 60",
    "native:timedemo:perf": "cargo run --release --manifest-path native/Cargo.toml -p mclone-native-client -- --timedemo --timedemo-frames 240",
    "native:frame-budget:smoke": "cargo run --manifest-path native/Cargo.toml -p mclone-native-client -- --frame-budget-probe --frame-budget-frames 60 --target-hz 120",
    "native:frame-budget:perf": "cargo run --release --manifest-path native/Cargo.toml -p mclone-native-client -- --frame-budget-probe --frame-budget-frames 240 --target-hz 120",
    "native:movement-frame:smoke": "cargo run --manifest-path native/Cargo.toml -p mclone-native-client -- --movement-frame-probe --frame-budget-frames 60 --target-hz 120",
    "native:movement-frame:perf": "cargo run --release --manifest-path native/Cargo.toml -p mclone-native-client -- --movement-frame-probe --frame-budget-frames 240 --target-hz 120",
    "native:xr:check": "bash ./scripts/start-xr.sh --check-only",
    "native:xr:smoke": "bash ./scripts/start-xr.sh --runtime wivrn --frames 2",
    "native:xr:mclone": "bash ./scripts/start-xr.sh --runtime wivrn --smoke mclone --frames 120",
    "native:xr:wivrn-usb": "bash ./scripts/start-xr.sh --runtime wivrn --wivrn-usb --frames 2",
    "native:xr:mac:wivrn:check": "bash ./scripts/start-xr.sh --runtime wivrn --check-only",
    "native:xr:mac:wivrn:smoke": "bash ./scripts/start-xr.sh --runtime wivrn --wivrn-usb --frames 2",
    "native:xr:mac:wivrn:mclone": "bash ./scripts/start-xr.sh --runtime wivrn --wivrn-usb --smoke mclone --frames 120",
    "native:xr:mac:wivrn:underwater:midpoint": "bash ./scripts/start-xr.sh --runtime wivrn --wivrn-usb --smoke mclone --xr-underwater-mode midpoint --frames 120",
    "native:xr:mac:wivrn:underwater:per-eye": "bash ./scripts/start-xr.sh --runtime wivrn --wivrn-usb --smoke mclone --xr-underwater-mode per-eye --frames 120",
    "native:xr:windows:check": "scripts\\start-xr.bat --check-only --runtime environment --no-pause",
    "native:xr:windows:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-quest-virtual-desktop.ps1",
    "native:xr:windows:restore": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-quest-virtual-desktop.ps1 -Restore -SleepAfterRestore",
    "native:xr:windows:sleep": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-quest-virtual-desktop.ps1 -SleepOnly",
    "native:xr:windows:smoke": "scripts\\start-xr.bat --vdxr --frames 2 --no-pause",
    "native:xr:windows:smoke:connected": "scripts\\start-xr.bat --vdxr --frames 2 --no-quest-launch --no-pause",
    "native:xr:windows:mclone:connected": "scripts\\start-xr.bat --vdxr --mclone --frames 120 --no-quest-launch --no-pause",
    "native:xr:windows:underwater:midpoint:connected": "scripts\\start-xr.bat --vdxr --mclone --xr-underwater-mode midpoint --frames 120 --no-quest-launch --no-pause",
    "native:xr:windows:underwater:per-eye:connected": "scripts\\start-xr.bat --vdxr --mclone --xr-underwater-mode per-eye --frames 120 --no-quest-launch --no-pause",
    "native:xr:windows:interactive": "scripts\\start-desktop-xr.bat --no-pause",
    "native:perf:smoke": "pnpm native:worldgen:smoke && pnpm native:movement:smoke && pnpm native:timedemo:smoke",
    "native:web:build": "cargo build --manifest-path native/Cargo.toml -p mclone-web-client --target wasm32-unknown-unknown",
    "native:web:bundle": "bash ./scripts/deploy-native-web.sh --bundle-only",
    "native:web:deploy": "bash ./scripts/deploy-native-web.sh",
    "native:web:serve": "node ./native/apps/mclone-web-client/scripts/browser-smoke.mjs --serve --app-loop",
    "native:web:smoke": "node ./native/apps/mclone-web-client/scripts/browser-smoke.mjs",
    "native:web:thread-smoke": "node ./native/apps/mclone-web-client/scripts/browser-smoke.mjs --require-threading",
    "native:web:remote-smoke": "node ./native/apps/mclone-web-client/scripts/browser-smoke.mjs --remote-websocket",
    "native:web:canvas-smoke": "node ./native/apps/mclone-web-client/scripts/browser-smoke.mjs --require-canvas",
    "native:web:chunk-smoke": "node ./native/apps/mclone-web-client/scripts/browser-smoke.mjs --require-canvas --require-chunk",
    "native:web:app-smoke": "node ./native/apps/mclone-web-client/scripts/browser-smoke.mjs --app-loop",
    "native:web:mobile-smoke": "node ./native/apps/mclone-web-client/scripts/browser-smoke.mjs --mobile-app-loop",
    "native:web:movement-perf": "node ./native/apps/mclone-web-client/scripts/browser-smoke.mjs --movement-perf",
    "native:web:glue": "node ./native/apps/mclone-web-client/scripts/build-web-glue.mjs",
    "native:web:typecheck": "node ./native/apps/mclone-web-client/scripts/browser-smoke.mjs --build-only && tsc --noEmit -p native/apps/mclone-web-client/tsconfig.json",
    "native:android:apk": "node ./scripts/run-native-bash.mjs ./android/build-apk.sh",
    "native:android:apk:avd": "node ./scripts/run-native-bash.mjs ./android/build-apk.sh --abi x86_64",
    "native:android:avd-smoke": "node ./scripts/run-native-bash.mjs ./android/validate-avd.sh --avd jstorrent-tablet --screenshot /tmp/mclone-android-avd-chunk.png --log /tmp/mclone-android-avd-logcat.txt --smoke-seconds 15",
    "native:android:avd-touch-smoke": "node ./scripts/run-native-bash.mjs ./android/validate-avd.sh --avd jstorrent-tablet --screenshot /tmp/mclone-android-avd-touch.png --log /tmp/mclone-android-avd-touch-logcat.txt --smoke-seconds 15 --touch-swipe 1280,820,1680,680,500",
    "native:android:avd-session-smoke": "node ./scripts/run-native-bash.mjs ./android/validate-avd.sh --avd jstorrent-tablet --screenshot /tmp/mclone-android-avd-session.png --log /tmp/mclone-android-avd-session-logcat.txt --smoke-seconds 15 --session-smoke new-world",
    "native:android:quest-flat": "node ./scripts/run-native-bash.mjs ./android/validate-quest-flat.sh",
    "native:android-xr:apk": "node ./scripts/run-native-bash.mjs ./android-xr/build-apk.sh",
    "native:android-xr:install": "node ./scripts/run-native-bash.mjs ./android-xr/install-quest-openxr.sh",
    "native:android-xr:interactive": "node ./scripts/run-native-bash.mjs ./android-xr/start-quest-openxr.sh",
    "native:android-xr:validate": "node ./scripts/run-native-bash.mjs ./android-xr/validate-quest-openxr.sh",
    "native:android-xr:multiview-proof": "node ./scripts/run-native-bash.mjs ./android-xr/validate-quest-openxr.sh --multiview-proof",
    "native:android-xr:session-smoke": "node ./scripts/run-native-bash.mjs ./android-xr/validate-quest-openxr.sh --debug --session-smoke new-world --view-pose 0,120,-96,180 --seed 12345 --chunk-x 0 --chunk-z 0 --render-distance 2 --day-time 6000 --freeze-time",
    "native:android-xr:perf": "node ./scripts/run-native-bash.mjs ./android-xr/validate-quest-openxr.sh --perf-seconds 10 --view-pose 0,120,-96,180 --seed 12345 --chunk-x 0 --chunk-z 0 --render-distance 2 --day-time 6000 --freeze-time",
    "native:android-xr:perf:flight:rd1": "node ./scripts/run-native-bash.mjs ./android-xr/validate-quest-openxr.sh --perf-seconds 20 --perf-flight --perf-flight-speed 4.3 --wait-seconds 120 --perf-summary /tmp/mclone-quest-openxr-perf-flight-rd1.txt --log /tmp/mclone-quest-openxr-perf-flight-rd1-logcat.txt --view-pose 0,120,-96,180 --seed 12345 --chunk-x 0 --chunk-z 0 --render-distance 1 --day-time 6000 --freeze-time",
    "native:android-xr:perf:flight:rd5": "node ./scripts/run-native-bash.mjs ./android-xr/validate-quest-openxr.sh --perf-seconds 20 --perf-flight --perf-flight-speed 4.3 --wait-seconds 150 --perf-summary /tmp/mclone-quest-openxr-perf-flight-rd5.txt --log /tmp/mclone-quest-openxr-perf-flight-rd5-logcat.txt --view-pose 0,120,-96,180 --seed 12345 --chunk-x 0 --chunk-z 0 --render-distance 5 --day-time 6000 --freeze-time",
    "native:android-xr:perf:flight:rd10": "node ./scripts/run-native-bash.mjs ./android-xr/validate-quest-openxr.sh --perf-seconds 20 --perf-flight --perf-flight-speed 4.3 --wait-seconds 210 --perf-summary /tmp/mclone-quest-openxr-perf-flight-rd10.txt --log /tmp/mclone-quest-openxr-perf-flight-rd10-logcat.txt --view-pose 0,120,-96,180 --seed 12345 --chunk-x 0 --chunk-z 0 --render-distance 10 --day-time 6000 --freeze-time",
    "native:android-xr:perf:flight:sweep": "pnpm native:android-xr:perf:flight:rd1 && node ./scripts/run-native-bash.mjs ./android-xr/validate-quest-openxr.sh --skip-build --skip-assets --perf-seconds 20 --perf-flight --perf-flight-speed 4.3 --wait-seconds 150 --perf-summary /tmp/mclone-quest-openxr-perf-flight-rd5.txt --log /tmp/mclone-quest-openxr-perf-flight-rd5-logcat.txt --view-pose 0,120,-96,180 --seed 12345 --chunk-x 0 --chunk-z 0 --render-distance 5 --day-time 6000 --freeze-time && node ./scripts/run-native-bash.mjs ./android-xr/validate-quest-openxr.sh --skip-build --skip-assets --perf-seconds 20 --perf-flight --perf-flight-speed 4.3 --wait-seconds 210 --perf-summary /tmp/mclone-quest-openxr-perf-flight-rd10.txt --log /tmp/mclone-quest-openxr-perf-flight-rd10-logcat.txt --view-pose 0,120,-96,180 --seed 12345 --chunk-x 0 --chunk-z 0 --render-distance 10 --day-time 6000 --freeze-time",
    "native:android-xr:perf:stationary:rd1": "node ./scripts/run-native-bash.mjs ./android-xr/validate-quest-openxr.sh --perf-seconds 20 --perf-settled-stationary --wait-seconds 150 --perf-summary /tmp/mclone-quest-openxr-perf-stationary-rd1.txt --log /tmp/mclone-quest-openxr-perf-stationary-rd1-logcat.txt --view-pose 0,120,-96,180 --seed 12345 --chunk-x 0 --chunk-z 0 --render-distance 1 --day-time 6000 --freeze-time",
    "native:android-xr:perf:stationary:rd5": "node ./scripts/run-native-bash.mjs ./android-xr/validate-quest-openxr.sh --perf-seconds 20 --perf-settled-stationary --wait-seconds 180 --perf-summary /tmp/mclone-quest-openxr-perf-stationary-rd5.txt --log /tmp/mclone-quest-openxr-perf-stationary-rd5-logcat.txt --view-pose 0,120,-96,180 --seed 12345 --chunk-x 0 --chunk-z 0 --render-distance 5 --day-time 6000 --freeze-time",
    "native:android-xr:perf:stationary:rd10": "node ./scripts/run-native-bash.mjs ./android-xr/validate-quest-openxr.sh --perf-seconds 20 --perf-settled-stationary --wait-seconds 240 --perf-summary /tmp/mclone-quest-openxr-perf-stationary-rd10.txt --log /tmp/mclone-quest-openxr-perf-stationary-rd10-logcat.txt --view-pose 0,120,-96,180 --seed 12345 --chunk-x 0 --chunk-z 0 --render-distance 10 --day-time 6000 --freeze-time",
    "native:android-xr:perf:stationary:sweep": "pnpm native:android-xr:perf:stationary:rd1 && node ./scripts/run-native-bash.mjs ./android-xr/validate-quest-openxr.sh --skip-build --skip-assets --perf-seconds 20 --perf-settled-stationary --wait-seconds 180 --perf-summary /tmp/mclone-quest-openxr-perf-stationary-rd5.txt --log /tmp/mclone-quest-openxr-perf-stationary-rd5-logcat.txt --view-pose 0,120,-96,180 --seed 12345 --chunk-x 0 --chunk-z 0 --render-distance 5 --day-time 6000 --freeze-time && node ./scripts/run-native-bash.mjs ./android-xr/validate-quest-openxr.sh --skip-build --skip-assets --perf-seconds 20 --perf-settled-stationary --wait-seconds 240 --perf-summary /tmp/mclone-quest-openxr-perf-stationary-rd10.txt --log /tmp/mclone-quest-openxr-perf-stationary-rd10-logcat.txt --view-pose 0,120,-96,180 --seed 12345 --chunk-x 0 --chunk-z 0 --render-distance 10 --day-time 6000 --freeze-time",
    "native:android-xr:perf:frozen:rd1": "node ./scripts/run-native-bash.mjs ./android-xr/validate-quest-openxr.sh --perf-seconds 20 --perf-frozen-render --wait-seconds 150 --perf-summary /tmp/mclone-quest-openxr-perf-frozen-rd1.txt --log /tmp/mclone-quest-openxr-perf-frozen-rd1-logcat.txt --view-pose 0,80,-96,180 --seed 12345 --chunk-x 0 --chunk-z 0 --render-distance 1 --day-time 6000 --freeze-time",
    "native:android-xr:perf:frozen:rd5": "node ./scripts/run-native-bash.mjs ./android-xr/validate-quest-openxr.sh --perf-seconds 20 --perf-frozen-render --wait-seconds 180 --perf-summary /tmp/mclone-quest-openxr-perf-frozen-rd5.txt --log /tmp/mclone-quest-openxr-perf-frozen-rd5-logcat.txt --view-pose 0,80,-96,180 --seed 12345 --chunk-x 0 --chunk-z 0 --render-distance 5 --day-time 6000 --freeze-time",
    "native:android-xr:perf:frozen:rd10": "node ./scripts/run-native-bash.mjs ./android-xr/validate-quest-openxr.sh --perf-seconds 20 --perf-frozen-render --wait-seconds 240 --perf-summary /tmp/mclone-quest-openxr-perf-frozen-rd10.txt --log /tmp/mclone-quest-openxr-perf-frozen-rd10-logcat.txt --view-pose 0,80,-96,180 --seed 12345 --chunk-x 0 --chunk-z 0 --render-distance 10 --day-time 6000 --freeze-time",
    "native:android-xr:perf:frozen:rd10:metrics": "node ./scripts/run-native-bash.mjs ./android-xr/validate-quest-openxr.sh --perf-seconds 20 --perf-frozen-render --perf-metrics --wait-seconds 240 --perf-summary /tmp/mclone-quest-openxr-perf-frozen-rd10-metrics.txt --log /tmp/mclone-quest-openxr-perf-frozen-rd10-metrics-logcat.txt --view-pose 0,80,-96,180 --seed 12345 --chunk-x 0 --chunk-z 0 --render-distance 10 --day-time 6000 --freeze-time",
    "native:android-xr:perf:frozen:sweep": "pnpm native:android-xr:perf:frozen:rd1 && node ./scripts/run-native-bash.mjs ./android-xr/validate-quest-openxr.sh --skip-build --skip-assets --perf-seconds 20 --perf-frozen-render --wait-seconds 180 --perf-summary /tmp/mclone-quest-openxr-perf-frozen-rd5.txt --log /tmp/mclone-quest-openxr-perf-frozen-rd5-logcat.txt --view-pose 0,80,-96,180 --seed 12345 --chunk-x 0 --chunk-z 0 --render-distance 5 --day-time 6000 --freeze-time && node ./scripts/run-native-bash.mjs ./android-xr/validate-quest-openxr.sh --skip-build --skip-assets --perf-seconds 20 --perf-frozen-render --wait-seconds 240 --perf-summary /tmp/mclone-quest-openxr-perf-frozen-rd10.txt --log /tmp/mclone-quest-openxr-perf-frozen-rd10-logcat.txt --view-pose 0,80,-96,180 --seed 12345 --chunk-x 0 --chunk-z 0 --render-distance 10 --day-time 6000 --freeze-time",
    "deploy": "pnpm native:web:deploy",
    "assets:pack": "node ./scripts/run-python.mjs ./tools/minecraft_assets/asset_pack.py",
    "assets:pack:check": "node ./scripts/run-python.mjs ./tools/minecraft_assets/asset_pack.py --check-lock",
    "assets:pack:write-lock": "node ./scripts/run-python.mjs ./tools/minecraft_assets/asset_pack.py --write-lock",
    "typecheck": "pnpm native:web:typecheck",
    "oracle:gen": "bash ./oracle/run.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@webgpu/types": "^0.1.69",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.1"
}
