{
  "name": "mclone",
  "version": "0.0.0",
  "private": true,
  "description": "Web-based Minecraft-inspired voxel sandbox (private, personal use).",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test --config playwright.config.ts",
    "test:browser:integration": "playwright test --config playwright.integration.config.ts",
    "probe:browser": "playwright test --config playwright.probes.config.ts",
    "probe:browser:fast": "playwright test --config playwright.probes.fast.config.ts",
    "probe:browser:parity": "playwright test --config playwright.probes.parity.config.ts",
    "probe:browser:regression": "playwright test --config playwright.probes.regression.config.ts",
    "smoke:deno:webgpu": "npx -y deno@2.7.13 run --unstable-webgpu --allow-write=/tmp ./scripts/deno-webgpu-smoke.ts",
    "smoke:deno:pipeline": "npx -y deno@2.7.13 run --unstable-webgpu --allow-write=/tmp ./scripts/deno-render-pipeline-smoke.ts",
    "smoke:deno:texture": "npx -y deno@2.7.13 run --unstable-webgpu --allow-write=/tmp ./scripts/deno-texture-decode-smoke.ts",
    "smoke:deno:atlas": "npx -y deno@2.7.13 run --unstable-webgpu --allow-write=/tmp ./scripts/deno-texture-atlas-smoke.ts",
    "smoke:deno:world": "npx -y deno@2.7.13 run --unstable-webgpu --allow-read=. --allow-write=/tmp ./scripts/deno-static-world-smoke.ts",
    "smoke:deno:world-assets": "npx -y deno@2.7.13 run --unstable-webgpu --allow-read=. --allow-write=/tmp ./scripts/deno-vanilla-asset-world-smoke.ts",
    "smoke:deno:generated-world": "npx -y deno@2.7.13 run --unstable-webgpu --allow-read=. --allow-write=/tmp ./scripts/deno-generated-world-smoke.ts",
    "dev:browser": "vite",
    "dev:lan": "node ./scripts/dev-lan.mjs",
    "host:check": "node ./scripts/check-host-capabilities.mjs",
    "host:node": "node --disable-warning=ExperimentalWarning --experimental-transform-types --experimental-loader ./scripts/node-ts-loader.mjs ./src/runtime/node/headless-generated-world-host.ts",
    "host:dedicated": "node --disable-warning=ExperimentalWarning --experimental-transform-types --experimental-loader ./scripts/node-ts-loader.mjs ./src/runtime/node/generated-world-http-server.ts",
    "host:remote": "pnpm host:dedicated",
    "bot:client": "node --disable-warning=ExperimentalWarning --experimental-transform-types --experimental-loader ./scripts/node-ts-loader.mjs ./src/runtime/node/bot-client.ts",
    "perf:worldgen": "node --disable-warning=ExperimentalWarning --experimental-transform-types --experimental-loader ./scripts/node-ts-loader.mjs ./scripts/worldgen-phase-baseline.ts",
    "perf:worldgen:flyby": "node --disable-warning=ExperimentalWarning --experimental-transform-types --experimental-loader ./scripts/node-ts-loader.mjs ./scripts/worldgen-host-flyby.ts",
    "perf:worldgen:browser-flyby": "playwright test --config playwright.worldgen-perf.config.ts --workers=1",
    "build": "vite build",
    "deploy": "bash ./scripts/deploy.sh",
    "assets:pack": "node ./scripts/build-reference-asset-pack.mjs",
    "typecheck": "tsc --noEmit",
    "oracle:gen": "bash ./oracle/run.sh",
    "perf:d5": "MCLONE_RUN_D5=1 playwright test --config playwright.perf.config.ts --workers=1"
  },
  "dependencies": {
    "unzipit": "^2.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@webgpu/types": "^0.1.69",
    "typescript": "^5.7.2",
    "vite": "^8.0.9",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.1"
}
