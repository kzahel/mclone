{
  "name": "mclone",
  "version": "0.0.0",
  "private": true,
  "description": "Native-first Minecraft-inspired voxel sandbox (private, personal use).",
  "type": "module",
  "scripts": {
    "test": "cargo test --manifest-path native/Cargo.toml",
    "host:check": "node ./scripts/check-host-capabilities.mjs",
    "native:scheduler:smoke": "cargo run --manifest-path native/Cargo.toml -p mclone-server --bin scheduler_movement_smoke --",
    "native:scheduler:perf": "cargo run --release --manifest-path native/Cargo.toml -p mclone-server --bin scheduler_movement_smoke --",
    "native:dedicated:smoke": "cargo run --manifest-path native/Cargo.toml -p mclone-dedicated-server -- --multi-client-smoke",
    "native:worldgen:smoke": "cargo run --manifest-path native/Cargo.toml -p mclone-worldgen --bin worldgen_perf --",
    "native:worldgen:perf": "cargo run --release --manifest-path native/Cargo.toml -p mclone-worldgen --bin worldgen_perf --",
    "native:runtime:smoke": "pnpm native:scheduler:smoke",
    "native:runtime:perf": "pnpm native:scheduler:perf",
    "native:movement:smoke": "cargo run --manifest-path native/Cargo.toml -p mclone-native-client -- --movement-perf",
    "native:movement:perf": "cargo run --release --manifest-path native/Cargo.toml -p mclone-native-client -- --movement-perf",
    "native:remote:smoke": "node ./scripts/native-remote-client-smoke.mjs",
    "native:desktop-chunk:smoke": "cargo run --manifest-path native/Cargo.toml -p mclone-native-client -- --headless-chunk /tmp/mclone-desktop-runtime-chunk.png --width 2560 --height 1600 --seed 12345 --chunk-x 0 --chunk-z 0 --render-distance 2 --day-time 6000 --freeze-time",
    "native:timedemo:smoke": "cargo run --manifest-path native/Cargo.toml -p mclone-native-client -- --timedemo --timedemo-frames 60",
    "native:timedemo:perf": "cargo run --release --manifest-path native/Cargo.toml -p mclone-native-client -- --timedemo --timedemo-frames 240",
    "native:frame-budget:smoke": "cargo run --manifest-path native/Cargo.toml -p mclone-native-client -- --frame-budget-probe --frame-budget-frames 60 --target-hz 120",
    "native:frame-budget:perf": "cargo run --release --manifest-path native/Cargo.toml -p mclone-native-client -- --frame-budget-probe --frame-budget-frames 240 --target-hz 120",
    "native:movement-frame:smoke": "cargo run --manifest-path native/Cargo.toml -p mclone-native-client -- --movement-frame-probe --frame-budget-frames 60 --target-hz 120",
    "native:movement-frame:perf": "cargo run --release --manifest-path native/Cargo.toml -p mclone-native-client -- --movement-frame-probe --frame-budget-frames 240 --target-hz 120",
    "native:perf:smoke": "pnpm native:worldgen:smoke && pnpm native:movement:smoke && pnpm native:timedemo:smoke",
    "native:web:build": "cargo build --manifest-path native/Cargo.toml -p mclone-web-client --target wasm32-unknown-unknown",
    "native:web:bundle": "bash ./scripts/deploy-native-web.sh --bundle-only",
    "native:web:deploy": "bash ./scripts/deploy-native-web.sh",
    "native:web:serve": "node ./native/apps/mclone-web-client/scripts/browser-smoke.mjs --serve --app-loop",
    "native:web:smoke": "node ./native/apps/mclone-web-client/scripts/browser-smoke.mjs",
    "native:web:thread-smoke": "node ./native/apps/mclone-web-client/scripts/browser-smoke.mjs --require-threading",
    "native:web:remote-smoke": "node ./native/apps/mclone-web-client/scripts/browser-smoke.mjs --remote-websocket",
    "native:web:canvas-smoke": "node ./native/apps/mclone-web-client/scripts/browser-smoke.mjs --require-canvas",
    "native:web:chunk-smoke": "node ./native/apps/mclone-web-client/scripts/browser-smoke.mjs --require-canvas --require-chunk",
    "native:web:app-smoke": "node ./native/apps/mclone-web-client/scripts/browser-smoke.mjs --app-loop",
    "native:web:mobile-smoke": "node ./native/apps/mclone-web-client/scripts/browser-smoke.mjs --mobile-app-loop",
    "native:web:movement-perf": "node ./native/apps/mclone-web-client/scripts/browser-smoke.mjs --movement-perf",
    "native:web:glue": "node ./native/apps/mclone-web-client/scripts/build-web-glue.mjs",
    "native:web:typecheck": "node ./native/apps/mclone-web-client/scripts/browser-smoke.mjs --build-only && tsc --noEmit -p native/apps/mclone-web-client/tsconfig.json",
    "native:android:apk": "bash ./android/build-apk.sh",
    "native:android:avd-smoke": "bash ./android/validate-avd.sh --avd jstorrent-tablet --screenshot /tmp/mclone-android-avd-chunk.png --log /tmp/mclone-android-avd-logcat.txt --smoke-seconds 15",
    "native:android:avd-touch-smoke": "bash ./android/validate-avd.sh --avd jstorrent-tablet --screenshot /tmp/mclone-android-avd-touch.png --log /tmp/mclone-android-avd-touch-logcat.txt --smoke-seconds 15 --touch-swipe 1280,820,1680,680,500",
    "native:android:quest-flat": "bash ./android/validate-quest-flat.sh",
    "deploy": "pnpm native:web:deploy",
    "assets:pack": "python3 ./scripts/build-reference-asset-pack.py",
    "assets:pack:check": "python3 ./scripts/build-reference-asset-pack.py --check-lock",
    "assets:pack:write-lock": "python3 ./scripts/build-reference-asset-pack.py --write-lock",
    "typecheck": "pnpm native:web:typecheck",
    "oracle:gen": "bash ./oracle/run.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@webgpu/types": "^0.1.69",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.1"
}
