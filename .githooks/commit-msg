#!/usr/bin/env bash
# Reject commits that mention AI assistant authorship.
set -euo pipefail

commit_msg_file="${1:-}"
if [ -z "$commit_msg_file" ] || [ ! -f "$commit_msg_file" ]; then
  exit 0
fi

commit_msg="$(cat "$commit_msg_file")"

if printf '%s\n' "$commit_msg" | grep -qiE "^Co-Authored-By:.*(Claude|Anthropic|anthropic|noreply@anthropic\\.com)"; then
  echo "ERROR: Commit message contains Co-Authored-By referencing the AI assistant." >&2
  echo "Per project guidelines, do not mention AI in commits." >&2
  exit 1
fi

if printf '%s\n' "$commit_msg" | grep -qi "Generated with.*Claude"; then
  echo "ERROR: Commit message contains 'Generated with Claude' reference." >&2
  echo "Per project guidelines, do not mention AI in commits." >&2
  exit 1
fi

exit 0
