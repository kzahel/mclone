# mclone integration oracle — regenerated per run via run-server.sh.
# Fields are pinned so the server's default overworld generation is the only
# variable between runs.
level-name=world
level-type=default
level-seed=__SEED__
generate-structures=false
generator-settings=
spawn-animals=false
spawn-monsters=false
spawn-npcs=false
spawn-protection=0
view-distance=10
simulation-distance=10
online-mode=false
white-list=false
enforce-whitelist=false
pvp=false
allow-nether=false
allow-flight=true
difficulty=peaceful
gamemode=creative
hardcore=false
force-gamemode=true
max-players=1
max-tick-time=60000
max-world-size=29999984
motd=mclone-oracle
network-compression-threshold=256
enable-command-block=false
enable-jmx-monitoring=false
enable-query=false
enable-rcon=false
enable-status=false
op-permission-level=4
broadcast-console-to-ops=false
broadcast-rcon-to-ops=false
use-native-transport=true
sync-chunk-writes=true
prevent-proxy-connections=false
function-permission-level=2
player-idle-timeout=0
rate-limit=0
server-ip=127.0.0.1
server-port=0
resource-pack=
resource-pack-sha1=
require-resource-pack=false
resource-pack-prompt=
text-filtering-config=
hide-online-players=true
entity-broadcast-range-percentage=100
