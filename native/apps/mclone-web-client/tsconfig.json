{
  // 070 Stage 2 / 071 Stage 1: no-emit type-check gate over the web glue. This config is checked
  // by `pnpm native:web:typecheck` (tsc --noEmit) only; browser-loadable output is produced by
  // tsconfig.web.json into the staged web root used by smoke/deploy. It covers the two boundaries
  // where this glue silently breaks: the wasm-return objects (typed against the generated
  // mclone_web_client.d.ts below) and the postMessage payloads (typed via JSDoc typedefs in the
  // worker glue), plus authored `.ts` modules as they graduate from JSDoc.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // www/* run in the browser DOM + Worker contexts; scripts/browser-smoke.mjs is a Node
    // harness — so the lib carries DOM + WebWorker and the types array carries both the WebGPU
    // globals (for the canvas/render glue) and Node globals (for the harness). skipLibCheck
    // suppresses the benign DOM-vs-Node duplicate-global lib conflicts.
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["@webgpu/types", "node"],

    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // The wasm-bindgen `--typescript` output lives in the gitignored cargo target dir (it is a
    // build artifact, regenerated by `native:web:build`/the smoke harness/deploy, never
    // committed and never cp'd into the deploy bundle). The web glue loads it at runtime via a
    // versioned dynamic `import()` URL, so this bare alias only ever appears inside JSDoc
    // `import("mclone-web-client-wasm")` type positions — it carries no runtime weight.
    "baseUrl": ".",
    "paths": {
      "mclone-web-client-wasm": [
        "../../target/wasm32-unknown-unknown/debug/mclone-web-client-bindgen/mclone_web_client"
      ]
    }
  },
  "include": ["www/**/*.js", "www/**/*.ts", "scripts/*.mjs"]
}
