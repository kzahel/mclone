{
  "name": "@mclone/texture-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "export": "tsx src/export.ts packs/mclone-default/texture.ts",
    "analyze": "tsx src/analyze.ts packs/mclone-default/texture.ts",
    "catalog": "tsx src/catalog.ts packs/mclone-default/texture.ts",
    "project-diffusion": "tsx src/project-diffusion.ts packs/mclone-default/texture.ts",
    "apply-curation": "tsx src/apply-curation.ts packs/mclone-default/texture.ts",
    "freeze-request": "tsx src/freeze-request.ts packs/mclone-default/texture.ts",
    "runtime-compat": "tsx src/export.ts packs/mclone-default/texture.ts --runtime-compat",
    "sheet": "tsx src/export.ts packs/mclone-default/texture.ts --sheet-only",
    "web:dev": "tsx src/web-server/server.ts",
    "web:build": "vite build --config src/web/vite.config.ts",
    "web:preview": "vite preview --host 127.0.0.1 --config src/web/vite.config.ts",
    "web:test": "playwright test -c playwright.config.ts"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2",
    "vite": "^8.1.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.1"
}
