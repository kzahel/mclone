{
  "name": "@mclone/structure-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/structure-json.test.ts && pnpm structures:check",
